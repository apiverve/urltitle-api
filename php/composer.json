            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "urltitle",
        "url title api",
        "extract page title",
        "get web page title",
        "get title from url",
        "fetch html title"
    ],
    "homepage": "https://apiverve.com/marketplace/urltitle?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/urltitle",
        "source": "https://github.com/apiverve/urltitle-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Urltitle\\": "src/"
        }
    },
    "autoload-dev": {
